DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/timeline
UPLOAD_DIR=/tmp/timeline_uploads
MAX_UPLOAD_MB=25
CORS_ORIGINS=["http://localhost:3000"]

# LLM (anthropic | openai | gemini)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=60

# OCR
OCR_LANGUAGE=eng
