DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/timeline
UPLOAD_DIR=/tmp/timeline_uploads
MAX_UPLOAD_MB=25
CORS_ORIGINS=["http://localhost:3000"]

# LLM (anthropic | openai)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OCR
OCR_LANGUAGE=eng
